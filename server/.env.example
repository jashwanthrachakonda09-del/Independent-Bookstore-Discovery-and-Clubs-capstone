# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore_discovery

# Session & Security
SESSION_SECRET=bookstore-discovery-super-secret-session-key-dev-only-change-in-prod
COOKIE_SECURE=false
HOLD_DURATION_HOURS=48

# Ollama AI Configuration (Local models detected: qwen3:8b, nomic-embed-text:latest, qwen3-embedding:4b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSION=768

# File Uploads
UPLOAD_MAX_BYTES=5242880
ALLOWED_FILE_TYPES=application/pdf,text/plain

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
